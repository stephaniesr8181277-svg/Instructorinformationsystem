@{
    var isSignedIn = User.Identity?.IsAuthenticated == true;
    var userName = User.Identity?.Name ?? string.Empty;
    var userInitial = string.IsNullOrEmpty(userName) ? "?" : userName[..1].ToUpperInvariant();
    var controllerName = ViewContext.RouteData.Values["controller"]?.ToString();
    var actionName = ViewContext.RouteData.Values["action"]?.ToString();
}
<!DOCTYPE html>
<html lang="en" data-bs-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Instructor Information System</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="site-header">
        <nav class="navbar navbar-expand-lg container header-inner" data-bs-theme="dark">
            <a class="brand" asp-controller="Account" asp-action="Dashboard">
                <span class="brand-badge">IIS</span>
                <span class="brand-text">Instructor Information System</span>
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavigation" aria-controls="mainNavigation" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse justify-content-lg-end" id="mainNavigation">
                @if (isSignedIn)
                {
                    <div class="main-nav">
                        <a class="nav-item-link @(controllerName == "Account" && actionName == "Dashboard" ? "active" : "")" asp-controller="Account" asp-action="Dashboard">Dashboard</a>
                        <a class="nav-item-link @(controllerName == "Instructor" ? "active" : "")" asp-controller="Instructor" asp-action="Index">Instructors</a>
                    </div>
                    <div class="user-box">
                        <span class="user-avatar">@userInitial</span>
                        <span class="user-name">Hi, <strong>@userName</strong></span>
                        <form asp-controller="Account" asp-action="Logout" method="post">
                            <button type="submit" class="btn btn-logout">Log out</button>
                        </form>
                    </div>
                }
                else
                {
                    <div class="main-nav">
                        <a class="nav-item-link @(actionName == "Login" ? "active" : "")" asp-controller="Account" asp-action="Login">Login</a>
                        <a class="nav-item-link @(actionName == "Register" ? "active" : "")" asp-controller="Account" asp-action="Register">Create account</a>
                    </div>
                }
            </div>
        </nav>
    </header>

    <main class="container page-shell">
        @RenderBody()
    </main>

    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>